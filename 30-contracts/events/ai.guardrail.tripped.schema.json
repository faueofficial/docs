{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/ai.guardrail.tripped.schema.json",
  "title": "ai.guardrail.tripped",
  "description": "Stage: MVP. Producer: ase. Consumers: analytics.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "ai.guardrail.tripped"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "ase"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guard": {
          "type": "string",
          "enum": [
            "input_safety",
            "intent_scope",
            "injection",
            "grounding",
            "output_moderation",
            "budget"
          ]
        },
        "category": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "guard",
        "category"
      ]
    }
  }
}
