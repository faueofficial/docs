{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/user.deletion.completed.schema.json",
  "title": "user.deletion.completed",
  "description": "Stage: MVP. Producer: any. Consumers: gateway.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "user.deletion.completed"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "type": "string"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ledger_id": {
          "type": "string",
          "format": "uuid"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "ledger_id",
        "module"
      ]
    }
  }
}
