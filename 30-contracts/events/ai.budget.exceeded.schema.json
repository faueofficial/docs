{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/ai.budget.exceeded.schema.json",
  "title": "ai.budget.exceeded",
  "description": "Stage: MVP. Producer: ase. Consumers: gateway, analytics.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "ai.budget.exceeded"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "ase"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "user_daily",
            "task_monthly",
            "global"
          ]
        },
        "task": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "spent": {
          "type": "number"
        }
      },
      "required": [
        "scope",
        "task",
        "limit",
        "spent"
      ]
    }
  }
}
