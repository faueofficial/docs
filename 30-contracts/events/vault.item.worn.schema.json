{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/vault.item.worn.schema.json",
  "title": "vault.item.worn",
  "description": "Stage: MVP. Producer: gateway. Consumers: ase, analytics.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "vault.item.worn"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "gateway"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "occasion": {
          "type": [
            "string",
            "null"
          ]
        },
        "worn_on": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "item_ids",
        "worn_on"
      ]
    }
  }
}
