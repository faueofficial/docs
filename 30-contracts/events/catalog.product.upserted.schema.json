{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/catalog.product.upserted.schema.json",
  "title": "catalog.product.upserted",
  "description": "Stage: M1-2. Producer: catalog. Consumers: ase.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "catalog.product.upserted"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "catalog"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "format": "uuid"
        },
        "brand_id": {
          "type": "string",
          "format": "uuid"
        },
        "image_url": {
          "type": "string",
          "format": "uri"
        },
        "fields": {
          "type": "object"
        }
      },
      "required": [
        "product_id",
        "brand_id",
        "image_url"
      ]
    }
  }
}
