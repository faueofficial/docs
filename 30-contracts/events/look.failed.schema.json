{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/look.failed.schema.json",
  "title": "look.failed",
  "description": "Stage: MVP. Producer: ase. Consumers: gateway, notify, analytics.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "look.failed"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "ase"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "empty_pool",
            "model_unavailable",
            "render_failed",
            "budget_exceeded",
            "guardrail_blocked",
            "timeout",
            "internal"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "context",
            "filter",
            "assemble",
            "rank",
            "render",
            "explain"
          ]
        }
      },
      "required": [
        "job_id",
        "reason_code",
        "stage"
      ]
    }
  }
}
