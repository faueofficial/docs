{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/recommendation.feedback.schema.json",
  "title": "recommendation.feedback",
  "description": "Stage: MVP. Producer: gateway. Consumers: ase, catalog.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "recommendation.feedback"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "gateway"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "look",
            "style",
            "item"
          ]
        },
        "target_id": {
          "type": "string",
          "format": "uuid"
        },
        "signal": {
          "type": "string",
          "enum": [
            "more_like_this",
            "not_my_style"
          ]
        }
      },
      "required": [
        "target_type",
        "target_id",
        "signal"
      ]
    }
  }
}
