{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faue.app/events/consent.changed.schema.json",
  "title": "consent.changed",
  "description": "Stage: MVP. Producer: gateway. Consumers: ase, notify, analytics.",
  "type": "object",
  "required": [
    "event_id",
    "name",
    "version",
    "occurred_at",
    "producer",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7. Consumers deduplicate on this."
    },
    "name": {
      "const": "consent.changed"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true, not when published."
    },
    "producer": {
      "const": "gateway"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "essential",
            "personalization",
            "ai_processing",
            "pinterest_sync",
            "camera_photos",
            "location_weather",
            "agent_proactive",
            "marketing_comms",
            "analytics"
          ]
        },
        "granted": {
          "type": "boolean"
        },
        "policy_version": {
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "granted",
        "policy_version"
      ]
    }
  }
}
